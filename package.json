{
  "name": "anshin",
  "displayName": "Anshin",
  "description": "Anshin sidebar sessions panel",
  "version": "0.0.6",
  "publisher": "aditya",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anshin",
          "title": "Anshin",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "anshin": [
        {
          "type": "webview",
          "id": "anshin.unoView",
          "name": "Sessions"
        }
      ]
    },
    "configuration": {
      "title": "Anshin",
      "properties": {
        "anshin.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Default Server Join URL for the Remote host toggle (include ?t= token). Leave empty to type it in the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "server": "node out/server.js",
    "test": "npm run compile && node --test out/uno/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
