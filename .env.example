# Copy to .env and fill in. The server loads this file itself.
# Variables already set in the shell or by pm2 are left unchanged.

PORT=3847
BIND_HOST=0.0.0.0

# Elastic IP or public DNS only. No ws:// and no port.
PUBLIC_HOST=

# Optional. When set, this is the advertised join URL and PUBLIC_HOST is not used.
# PUBLIC_URL=wss://uno.example.com

# Empty generates a token and prints it once at startup.
ROOM_TOKEN=
